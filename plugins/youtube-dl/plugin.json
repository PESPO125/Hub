{
  "id": "youtube-dl",
  "name": "Youtube",
  "version": "1.3",
  "categories": ["media"],
  "icon": "video",
  "integration": {
    "type": "subprocess",
    "entrypoint": "main.py"
  },
  "tools": [
    {
      "id": "download-video",
      "name": "Video downloader",
      "description": "Descarga videos o audios de YouTube pegando el enlace.",
      "params_schema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {"type": "string", "format": "uri", "maxLength": 2048}
        },
        "additionalProperties": false
      },
      "max_concurrency": 1,
      "timeout_seconds": 1800
    }
  ],
  "permissions": ["files.write", "network.outbound"]
}
