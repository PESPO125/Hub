{
  "$defs": {
    "Integration": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "python_inprocess",
            "subprocess",
            "remote_api"
          ],
          "title": "Type",
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        }
      },
      "required": [
        "type"
      ],
      "title": "Integration",
      "type": "object"
    },
    "PlatformCompat": {
      "additionalProperties": false,
      "properties": {
        "min_version": {
          "default": "0.1",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Min Version",
          "type": "string"
        },
        "max_version": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Version"
        }
      },
      "title": "PlatformCompat",
      "type": "object"
    },
    "ToolDecl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "title": "Description",
          "type": "string"
        },
        "params_schema": {
          "title": "Params Schema",
          "type": "object"
        },
        "max_concurrency": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolDecl",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,47}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 400,
      "title": "Description",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "contract_version": {
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "categories": {
      "items": {
        "enum": [
          "media",
          "documents",
          "images",
          "developer",
          "ai",
          "files",
          "utilities"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "title": "Categories",
      "type": "array"
    },
    "icon": {
      "default": "puzzle",
      "enum": [
        "wrench",
        "download",
        "file-text",
        "image",
        "music",
        "video",
        "qr-code",
        "code",
        "sparkles",
        "folder",
        "scissors",
        "file-archive",
        "terminal",
        "globe",
        "puzzle"
      ],
      "title": "Icon",
      "type": "string"
    },
    "integration": {
      "$ref": "#/$defs/Integration"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolDecl"
      },
      "maxItems": 20,
      "title": "Tools",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Capabilities",
      "type": "array"
    },
    "permissions": {
      "items": {
        "enum": [
          "files.read",
          "files.write",
          "network.outbound",
          "process.spawn",
          "config.read"
        ],
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "config_requirements": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Config Requirements",
      "type": "array"
    },
    "platform": {
      "$ref": "#/$defs/PlatformCompat"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "integration"
  ],
  "title": "PluginManifest",
  "type": "object"
}
